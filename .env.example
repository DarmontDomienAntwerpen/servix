# OpenAI: answers, embeddings and vision-based PDF parsing
OPENAI_API_KEY=

# Twilio WhatsApp: only needed for the real WhatsApp channel
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
